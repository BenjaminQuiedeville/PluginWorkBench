[16]

[[workspace]]
./
C:/Odin/core
C:/Odin/base
C:/Odin/vendor


[[build commands]]
build_working_dir:      %PROJECT_CONFIG_DIR%
open_panel_on_build:    true  #  <- any settings specified here will apply to all commands unless overridden
close_panel_on_success: true
auto_jump_to_error:     true
# error_regex:            ^(?P<file>.*)\((?P<line>\d+),?(?P<col>\d+)?\)[ ]?: (?P<type>error|warning) (?P<msg>.*)$
error_regex:            ^(?P<file>.*)\((?P<line>\d+):(?P<col>\d+)\) (?P<type>Error|Syntax Error): (?P<msg>.*)$

[Debug Build]   # <- command name. Can be arbitrary
build_command:          odin build Source -debug -out:bench.exe
build_working_dir:      %PROJECT_CONFIG_DIR%
# timeout_in_seconds:     5             # if you don't want a timeout, don't specify it
key_binding:            F5


[Debug Build & Run AmpModeler]   # <- command name. Can be arbitrary
build_command:          odin build Source -debug -out:bench.exe
build_working_dir:      %PROJECT_CONFIG_DIR%
run_command:            bench.exe -plugin:./test_files/AmpModeler/AmpModeler.vst3/Contents/x86_64-win/AmpModeler.vst3 -audio-file:test_files/opeth.wav
# timeout_in_seconds:     5             # if you don't want a timeout, don't specify it
key_binding:            F6

[Debug Build & Run clap_ambient]   # <- command name. Can be arbitrary
build_command:          odin build Source -debug -out:bench.exe
build_working_dir:      %PROJECT_CONFIG_DIR%
run_command:            bench.exe -plugin:./test_files/clap_ambient.vst3 -audio-file:test_files/opeth.wav
# timeout_in_seconds:     5             # if you don't want a timeout, don't specify it
key_binding:            F7

